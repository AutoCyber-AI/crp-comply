# CRP Comply Backend Environment Variables
# Copy this file to .env and fill in your values.

# Clerk (auth) — https://dashboard.clerk.com
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# CORS — comma-separated allowed origins
CRP_COMPLY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe (billing) — https://dashboard.stripe.com/apikeys
# Live price IDs are in SPEC-047 §1.1. Use the test equivalents in Stripe test mode.
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# CRP Comply plans (SPEC-047). Replace <YOUR_...> placeholders with your own
# Stripe price IDs. Annual variants are optional.
STRIPE_COMPLY_STARTER_MONTHLY_PRICE_ID=<YOUR_COMPLY_STARTER_MONTHLY_PRICE_ID>
# STRIPE_COMPLY_STARTER_ANNUAL_PRICE_ID=<YOUR_COMPLY_STARTER_ANNUAL_PRICE_ID>
STRIPE_COMPLY_SCALE_MONTHLY_PRICE_ID=<YOUR_COMPLY_SCALE_MONTHLY_PRICE_ID>
# STRIPE_COMPLY_SCALE_ANNUAL_PRICE_ID=<YOUR_COMPLY_SCALE_ANNUAL_PRICE_ID>

# CRP Comply credit top-ups (optional)
STRIPE_COMPLY_CREDITS_5_PRICE_ID=<YOUR_COMPLY_CREDITS_5_PRICE_ID>
STRIPE_COMPLY_CREDITS_20_PRICE_ID=<YOUR_COMPLY_CREDITS_20_PRICE_ID>
STRIPE_COMPLY_CREDITS_50_PRICE_ID=<YOUR_COMPLY_CREDITS_50_PRICE_ID>

# CRP Scan plans
STRIPE_SCAN_PRO_PRICE_ID=<YOUR_SCAN_PRO_PRICE_ID>
STRIPE_SCAN_BUSINESS_PRICE_ID=<YOUR_SCAN_BUSINESS_PRICE_ID>

# CRP Gateway plans
STRIPE_GATEWAY_DEVELOPER_MONTHLY_PRICE_ID=<YOUR_GATEWAY_DEVELOPER_MONTHLY_PRICE_ID>
# STRIPE_GATEWAY_DEVELOPER_ANNUAL_PRICE_ID=<YOUR_GATEWAY_DEVELOPER_ANNUAL_PRICE_ID>
STRIPE_GATEWAY_TEAM_MONTHLY_PRICE_ID=<YOUR_GATEWAY_TEAM_MONTHLY_PRICE_ID>
# STRIPE_GATEWAY_TEAM_ANNUAL_PRICE_ID=<YOUR_GATEWAY_TEAM_ANNUAL_PRICE_ID>

# Stripe product IDs (used for customer-portal / checkout metadata)
STRIPE_COMPLY_STARTER_PRODUCT_ID=<YOUR_COMPLY_STARTER_PRODUCT_ID>
STRIPE_COMPLY_SCALE_PRODUCT_ID=<YOUR_COMPLY_SCALE_PRODUCT_ID>
STRIPE_COMPLY_CREDITS_PRODUCT_ID=<YOUR_COMPLY_CREDITS_PRODUCT_ID>
STRIPE_SCAN_PRO_PRODUCT_ID=<YOUR_SCAN_PRO_PRODUCT_ID>
STRIPE_SCAN_BUSINESS_PRODUCT_ID=<YOUR_SCAN_BUSINESS_PRODUCT_ID>
STRIPE_GATEWAY_DEVELOPER_PRODUCT_ID=<YOUR_GATEWAY_DEVELOPER_PRODUCT_ID>
STRIPE_GATEWAY_TEAM_PRODUCT_ID=<YOUR_GATEWAY_TEAM_PRODUCT_ID>

# Legacy aliases (still honoured for existing deployments)
# STRIPE_COMPLY_PRO_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
# STRIPE_COMPLY_ENTERPRISE_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
# STRIPE_COMPLY_CLOUD_PRICE_ID=<YOUR_STRIPE_PRICE_ID>

# Frontend base URL (for Stripe success/cancel redirects)
CRP_COMPLY_BASE_URL=http://localhost:5173

# Passkey MFA (FIDO2/WebAuthn)
# RP ID must match the domain the passkey is bound to (no scheme, no port).
PASSKEY_RP_ID=comply.crprotocol.io
PASSKEY_ORIGIN=https://comply.crprotocol.io
PASSKEY_SESSION_TTL_SECONDS=3600

# ── Persistence backend ─────────────────────────────────────────
# Default is file-backed under CRP_COMPLY_DATA_DIR. This is the correct
# choice for Railway deployments with an attached volume, because the
# volume survives redeploys and Redis restarts. Only set this to "redis"
# if your Redis deployment is itself durable (AOF/RDB + persistent disk).
CRP_COMPLY_PERSISTENCE_STORE=file
# CRP_COMPLY_REDIS_URL=redis://localhost:6379/0
# CRP_COMPLY_PERSISTENCE_TTL_SECONDS=0  # 0 = no expiration for org/provider/session data

# CSO (agent memory) persistence backend — separate from general persistence
# so long session-memory TTLs can be configured independently.
# CRP_COMPLY_CSO_STORE=redis
# CRP_COMPLY_CSO_TTL_SECONDS=604800  # 7 days

# Gateway integration (SPEC-042)
CRP_GATEWAY_URL=https://gateway.crprotocol.io
# CRP_GATEWAY_KEY=gw-...

# Shared secret used to verify signed audit-stream webhooks from Gateway.
# Must match the Gateway's COMPLY_WEBHOOK_API_KEY.
CRP_COMPLY_WEBHOOK_SECRET=shared-secret-between-gateway-and-comply

# Optional: server-managed upstream LLM (if not using per-user config)
# CRP_COMPLY_UPSTREAM_API_KEY=<YOUR_API_KEY>

# ── LLM / Provider ──────────────────────────────────────────────
# CRP Comply can use either per-user BYOK config (Settings → AI provider)
# or instance-wide env vars below. Per-user config takes precedence.
#
# OpenAI-compatible endpoint (covers Groq, Together, DeepInfra, LM Studio,
# Ollama via OpenAI compat, and any other /v1 provider).
# CRP_COMPLY_LLM_BASE_URL=https://api.openai.com/v1
# CRP_COMPLY_LLM_API_KEY=<YOUR_API_KEY>
# CRP_COMPLY_LLM_MODEL=gpt-4o-mini
#
# Fallback context-window budget when the upstream does not report a
# loaded_context_length or max_context_length value.
# CRP_COMPLY_CTX_WINDOW=8192
#
# In multi-tenant SaaS deployments the instance-wide env LLM must NOT be
# leaked to tenants who have not configured BYOK. Set this to 1 only for
# single-tenant/self-hosted Docker deploys.
# CRP_COMPLY_EXPOSE_ENV_LLM=0
#
# Provider-native API keys (used when CRP_COMPLY_LLM_* are absent).
# OPENAI_API_KEY=<YOUR_API_KEY>
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPINFRA_API_KEY=...
